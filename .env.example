# Copy this file to .env.local and replace the placeholder locally.
# In Supabase: open your project, click Connect, and choose Session pooler.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase API values for future Shiny/app integration.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-side/admin use only. Never commit real service-role keys.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Local development only. Set to true to bypass the prototype login locally.
ENTONET_SKIP_LOGIN=false
