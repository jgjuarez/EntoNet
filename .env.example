# Copy this file to .env.local and replace the placeholder locally.
# In Supabase: open your project, click Connect, and choose Session pooler.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase API values used by Shiny for Supabase Auth and Storage.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
# SUPABASE_PUBLISHABLE_KEY can be used instead of SUPABASE_ANON_KEY in newer projects.

# Server-side/admin use only. Never commit real service-role keys.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public URL where Supabase invitation and recovery links return.
# Local example: http://127.0.0.1:3841
# Production example: https://your-entonet-app.posit.co
ENTONET_AUTH_REDIRECT_URL=http://127.0.0.1:3841

# Local development only. Set to true only when working offline.
ENTONET_SKIP_LOGIN=false

# Default institution for new records when a profile does not override it.
ENTONET_DEFAULT_INSTITUTION_ID=UVG
